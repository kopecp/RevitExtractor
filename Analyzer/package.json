{
  "name": "revit-extractor-analyzer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local SVF viewer and read-only RevitExtractor export explorer",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "test:pages": "node --test tests/pages.test.mjs tests/source-models.test.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299",
    "sql.js": "1.15.2"
  }
}
