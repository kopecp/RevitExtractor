<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revit Extractor — konfiguracja eksportu" Width="1080" Height="800"
        MinWidth="920" MinHeight="650" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="#F3F5F8" Foreground="#17263B"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Foreground" Value="#17263B"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,7,0,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#17263B"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,6,22,6"/>
            <Setter Property="Foreground" Value="#17263B"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#17263B"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Foreground" Value="#17263B"/>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#17263B"/>
            <Setter Property="BorderBrush" Value="#D5DDE7"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
        </Style>
        <DataTemplate x:Key="CheckTemplate">
            <CheckBox IsChecked="{Binding checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Margin="8,4" ToolTip="Zaznacz do eksportu"/>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Konfiguracja eksportu" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock x:Name="model_title" FontWeight="SemiBold" Margin="0,6,0,2"/>
                <TextBlock x:Name="model_path" Foreground="#536277" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="model_note" Foreground="#536277" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="reset_btn" Grid.Column="1" Content="Przywróć domyślne" VerticalAlignment="Top" Margin="15,0,0,0"/>
        </Grid>
        <Border Grid.Row="1" Background="White" BorderBrush="#D5DDE7" BorderThickness="1" CornerRadius="6" Padding="16,9" Margin="0,0,0,14">
            <UniformGrid Columns="3">
                <CheckBox x:Name="enable2d_cb" Content="Widoki 2D i arkusze" FontWeight="SemiBold"/>
                <CheckBox x:Name="enable3d_cb" Content="Widoki 3D" FontWeight="SemiBold"/>
                <CheckBox x:Name="pdb_cb" Content="Lokalna baza danych SQLite" FontWeight="SemiBold"/>
            </UniformGrid>
        </Border>
        <TabControl Grid.Row="2" Background="White" BorderBrush="#D5DDE7">
            <TabItem x:Name="tab2d" Header="Widoki 2D i arkusze">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <RadioButton x:Name="default2d_rb" Content="Domyślny zakres Extractora" GroupName="scope2d"/>
                        <RadioButton x:Name="selected2d_rb" Content="Tylko zaznaczone" GroupName="scope2d"/>
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Text="Domyślny zakres pozostawia wybór Extractorowi. Wybierz „Tylko zaznaczone”, aby wskazać konkretne rysunki."
                               Foreground="#536277" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <Grid Grid.Row="2" x:Name="choose2d_panel">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Szukaj po nazwie, numerze arkusza lub ID" Margin="0,0,0,4"/>
                                <TextBox x:Name="search2d_tb"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Typ widoku" Margin="0,0,0,4"/>
                                <ComboBox x:Name="kind2d_cb" Padding="8,6" Background="White" Foreground="#17263B"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
                            <Button x:Name="all2d_btn" Tag="2d:all" Content="Zaznacz widoczne"/>
                            <Button x:Name="none2d_btn" Tag="2d:none" Content="Odznacz widoczne"/>
                        </StackPanel>
                        <ListView Grid.Row="2" x:Name="views2d_lv">
                            <ListView.View><GridView>
                                <GridViewColumn Header="✓" Width="46" CellTemplate="{StaticResource CheckTemplate}"/>
                                <GridViewColumn Header="Nazwa widoku / numer i nazwa arkusza" Width="475" DisplayMemberBinding="{Binding name}"/>
                                <GridViewColumn Header="Typ" Width="205" DisplayMemberBinding="{Binding kind}"/>
                                <GridViewColumn Header="ElementId" Width="110" DisplayMemberBinding="{Binding element_id}"/>
                            </GridView></ListView.View>
                        </ListView>
                        <TextBlock Grid.Row="3" x:Name="count2d_text" Margin="0,10,0,0" Foreground="#536277"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="tab3d" Header="Widoki 3D">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <RadioButton x:Name="default3d_rb" Content="Domyślny zakres Extractora" GroupName="scope3d"/>
                        <RadioButton x:Name="selected3d_rb" Content="Tylko zaznaczone" GroupName="scope3d"/>
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Text="Zaznaczenia są zachowywane podczas wyszukiwania. Lista obejmuje widoki aktywnego modelu."
                               Foreground="#536277" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <Grid Grid.Row="2" x:Name="choose3d_panel">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Szukaj po nazwie lub ID" Margin="0,0,0,4"/>
                            <TextBox x:Name="search3d_tb"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
                            <Button x:Name="all3d_btn" Tag="3d:all" Content="Zaznacz widoczne"/>
                            <Button x:Name="none3d_btn" Tag="3d:none" Content="Odznacz widoczne"/>
                        </StackPanel>
                        <ListView Grid.Row="2" x:Name="views3d_lv">
                            <ListView.View><GridView>
                                <GridViewColumn Header="✓" Width="46" CellTemplate="{StaticResource CheckTemplate}"/>
                                <GridViewColumn Header="Nazwa widoku" Width="680" DisplayMemberBinding="{Binding name}"/>
                                <GridViewColumn Header="ElementId" Width="110" DisplayMemberBinding="{Binding element_id}"/>
                            </GridView></ListView.View>
                        </ListView>
                        <TextBlock Grid.Row="3" x:Name="count3d_text" Margin="0,10,0,0" Foreground="#536277"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Opcje zaawansowane">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Domyślne wartości odpowiadają obecnemu presetowi. Dodatkowe tryby wymagają sprawdzenia na wybranym modelu."
                                   TextWrapping="Wrap" Foreground="#536277" Margin="0,0,0,14"/>
                        <StackPanel x:Name="advanced3d_panel">
                            <TextBlock Text="Dane i widoki 3D" FontSize="16" FontWeight="SemiBold"/>
                            <CheckBox x:Name="aec_cb" Content="Dane AEC — poziomy, fazy, osie i informacje o modelu"/>
                            <CheckBox x:Name="description_cb" Content="Opis dokumentu i zależności między plikami"/>
                            <CheckBox x:Name="master_cb" Content="Generuj dodatkowe widoki master"/>
                            <CheckBox x:Name="topology_cb" Content="Dodatkowe metadane topologii"/>
                        </StackPanel>
                        <Separator Margin="0,12"/>
                        <TextBlock Text="Baza danych i rysunki 2D" FontSize="16" FontWeight="SemiBold"/>
                        <CheckBox x:Name="extended_cb" Content="Rozszerzona baza właściwości"/>
                        <CheckBox x:Name="f2d_cb" Content="Przetwarzanie 2D w trybie F2D"/>
                        <Separator Margin="0,12"/>
                        <TextBlock Text="Dodatkowe formaty" FontSize="16" FontWeight="SemiBold"/>
                        <CheckBox x:Name="dwg_cb" Content="DWG"/>
                        <CheckBox x:Name="ifc_cb" Content="IFC"/>
                        <TextBlock Text="Ustawienia IFC możesz przygotować w zakładce Setup IFC. DWG korzysta z natywnych ustawień eksportera."
                                   TextWrapping="Wrap" Foreground="#536277" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="ifc_tab" Header="Setup IFC">
                <Grid Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Wybierz zapisany setup Autodesk" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Przygotujemy zgodny zapis pod tą samą nazwą. Po zastosowaniu zapisz index.json oraz RVT."
                                   TextWrapping="Wrap" Foreground="#536277" Margin="0,6,0,2"/>
                        <ComboBox x:Name="ifc_source_cb" Padding="8,6" Margin="0,6,0,2"/>
                        <WrapPanel>
                            <CheckBox x:Name="ifc_export_tab_cb" Content="Eksportuj IFC" Margin="0,7,22,7"
                                      IsChecked="{Binding IsChecked, ElementName=ifc_cb, Mode=TwoWay}"/>
                            <CheckBox x:Name="ifc_use_setup_cb" Content="Wskaż wybrany setup w index.json"/>
                        </WrapPanel>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                            <StackPanel x:Name="ifc_editor_panel" Margin="0,0,22,0">
                                <TextBlock Text="Wersja IFC" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ifc_version_cb" Padding="8,6" Margin="0,0,0,12"/>
                                <TextBlock Text="Granice pomieszczeń (Space Boundaries)" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ifc_boundaries_cb" Padding="8,6" Margin="0,0,0,12"/>
                                <StackPanel x:Name="ifc_flags_panel"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <Border Background="#EDF3FA" Padding="14" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="Jak użyć ustawień" FontWeight="SemiBold"/>
                                        <TextBlock Text="Przycisk poniżej zapisze obsługiwane ustawienia w modelu. index.json wskaże nazwę wybranego setupu. Następnie zapisz plik RVT i uruchom eksport."
                                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Przenoszone ustawienia i uproszczenia" FontWeight="SemiBold" Margin="0,16,0,6"/>
                                <TextBlock x:Name="ifc_info_text" Foreground="#536277" TextWrapping="Wrap"/>
                                <TextBlock Text="Oryginalny JSON Autodesk pozostaje zachowany. Linki eksportujemy jako osobne pliki. Po późniejszej edycji setupów w Autodesk przygotuj zgodny zapis ponownie."
                                           Foreground="#536277" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock x:Name="ifc_status_text" TextWrapping="Wrap" Foreground="#536277" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <Button x:Name="ifc_apply_btn" Content="Przygotuj setup dla Extractora" Background="#173D69" Foreground="White"/>
                            <Button x:Name="ifc_defaults_btn" Content="Wczytaj ustawienia źródłowe"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Podgląd index.json">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Taką konfigurację zapisze przycisk poniżej." Margin="0,0,0,10" Foreground="#536277"/>
                    <TextBox Grid.Row="1" x:Name="json_tb" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                             AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                <TextBlock x:Name="summary_text" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="status_text" Margin="0,5,0,0" Foreground="#536277" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="close_btn" Content="Zamknij"/>
                <Button x:Name="save_btn" Content="Zapisz index.json" Background="#173D69" Foreground="White" FontWeight="SemiBold" Margin="0" Padding="18,10"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
